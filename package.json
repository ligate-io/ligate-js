{
  "name": "@ligate-labs/sdk",
  "version": "0.0.2",
  "description": "TypeScript SDK for Ligate Chain. Build-sign-submit transactions, query state, manage keys.",
  "homepage": "https://ligate.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ligate-io/ligate-js.git"
  },
  "bugs": {
    "url": "https://github.com/ligate-io/ligate-js/issues"
  },
  "license": "(Apache-2.0 OR MIT)",
  "author": "Ligate Labs <hello@ligate.io>",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "bundle:browser-check": "esbuild src/index.ts --bundle --platform=browser --target=es2022 --format=esm --outfile=/dev/null",
    "fmt": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"e2e/**/*.ts\"",
    "fmt:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"e2e/**/*.ts\""
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0",
    "@scure/base": "^1.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "esbuild": "^0.24.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ligate",
    "ligate-chain",
    "attestation",
    "sdk",
    "typescript",
    "blockchain",
    "rollup"
  ]
}
